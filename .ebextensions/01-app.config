# Configuración del entorno de Elastic Beanstalk.
#
# Las variables sensibles (GITHUB_TOKEN) NO van aquí: se cargan con
# `eb setenv GITHUB_TOKEN=...` para que no queden versionadas en el repositorio.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production

  aws:elasticbeanstalk:environment:process:default:
    # El balanceador pregunta por /health, que responde sin tocar la API de GitHub.
    HealthCheckPath: /health
    MatcherHTTPCode: '200'

  aws:elasticbeanstalk:command:
    DeploymentPolicy: AllAtOnce
