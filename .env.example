# Puerto local del servidor Express (Beanstalk inyecta PORT=8080)
PORT=8080

# Token opcional de GitHub (Personal Access Token, solo permisos public_repo).
# Sin token: 60 peticiones/hora por IP. Con token: 5000/hora.
# En Beanstalk se configura como variable de entorno del entorno, NO se commitea.
GITHUB_TOKEN=

# Usuario de GitHub cuyos repos se muestran
GITHUB_USER=Rodrixxx7676

# Minutos que se cachean las respuestas de GitHub en memoria
GITHUB_CACHE_TTL_MINUTES=30
